# Fluxora Mobile Frontend Environment Configuration
# Copy this file to .env and update with your actual values

# Backend API Configuration
# - Android Emulator: use 10.0.2.2:8000 (localhost alias) -- this is the default if unset
# - iOS Simulator: use localhost:8000
# - Physical Device / Expo Go: use your computer's LAN IP (e.g., 192.168.1.100:8000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
